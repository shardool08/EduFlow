rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /catalog/tlm/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    match /catalog/flashcards/{lessonId}/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{userId}/resources/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
